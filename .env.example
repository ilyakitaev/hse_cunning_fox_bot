# Telegram Bot
TELEGRAM_BOT_API=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
USE_WEBHOOK=false
PROXY_URL=

# LLM Configuration
LLM_APIKEY=your_llm_api_key_here
LLM_ENDPOINT=https://api.minimax.io/v1/text/chatcompletion_v2

# Qdrant Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Bot Settings
AUTH_PASSWORD=secret_password
ADMIN_USER_IDS=

